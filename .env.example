# Local environment template. Keep .env.local private; it is gitignored.
MONGODB_URI=
MONGODB_DB=merasoftware

# Data driver: "json" = local .data files, "mongo" = MongoDB
DATA_DRIVER=json

# Cloudinary server credentials; never use NEXT_PUBLIC_ for these values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ASSET_FOLDER=merasoftware

# Shared with the portal backend worker. Generate a random secret of >=32 characters.
# Never expose it as NEXT_PUBLIC_ or REACT_APP_.
PORTFOLIO_INTEGRATION_SECRET=
# Existing shared-login integration; use the portal backend origin, without /api.
PORTAL_API_URL=
PORTAL_URL=
TOKEN_SECRET_KEY=

# IndexNow key (8-128 letters, digits or dashes). Set on Vercel Production only;
# pings go out only when VERCEL_ENV=production. Served at /indexnow-key.txt.
INDEXNOW_KEY=
