    "SEO Basics"
  ],
  "seo": {
    "title": "Good-Looking Website But No Enquiries? Here’s Why",
    "description": "Your website may look professional but still fail to generate enquiries. Learn how SEO, clear content, and website structure help customers find your business.",
    "canonical": ""
  },
